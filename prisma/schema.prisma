// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

generator zod {
  provider          = "zod-prisma-types"
  useTypeAssertions = "true"
}

generator erd {
  provider = "prisma-erd-generator"
  disabled = "true"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  User
  Admin
  Support
}

enum AccountStatus {
  Pending
  Active
  Inactive
  Password_Reset_Required
}

model User {
  id                     String               @id @default(uuid())
  /// @zod.string.min(3, { message: "First name must be at least 3 characters long." }).max(50, { message: "First name must not exceed 50 characters." })
  given_name             String
  /// @zod.string.min(3, { message: "Last name must be at least 3 characters long." }).max(50, { message: "Last name must not exceed 50 characters." })
  family_name            String
  /// @zod.string.email()
  email                  String               @unique
  /// @zod.string.min(6, { message: "Password must be at least 6 characters long." }).max(50, { message: "Password must not exceed 50 characters." })
  password               String
  stripeCustomerId       String?              @unique
  userRole               UserRole             @default(User)
  accountStatus          AccountStatus        @default(Pending)
  Subscription           Subscription?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @default(now())
  colorScheme            String               @default("theme-orange")
  connectedAccountId     String?              @unique
  stripeConnectedLinked  Boolean              @default(false)
  Product                Product[]
  notifications          Notification[]       @relation("UserNotifications")
  listings               Listing[]
  reservations           Reservation[]
}


model Notification {
  id        String   @id @default(uuid())
  message   String
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation("UserNotifications", fields: [userId], references: [id])
  isRead    Boolean  @default(false)
}

model Listing {
  id                     String               @id @default(uuid())
  title                  String
  description            String
  imageSrc               String
  createdAt              DateTime             @default(now())
  category               String
  time                   String?
  bathroomCount          Int?
  guestCount             Int?
  locationValue          String
  userId                 String               @unique
  price                  Int
  featureOne             String?
  featureTwo             String?
  user         User           @relation(fields: [userId], references: [id])
  reservations Reservation[]
}

model Reservation {
  id         String   @id @default(uuid())
  userId     String
  listingId  String
  startDate  DateTime
  endDate    DateTime
  startTime  String
  endTime    String
  totalPrice Int
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
  listing    Listing  @relation(fields: [listingId], references: [id])
}


model Subscription {
  stripeSubscriptionId String                 @id @unique
  interval             String
  status               String
  planId               String
  planName             String?
  currentPeriodStart   Int
  currentPeriodEnd     Int
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  user                 User                   @relation(fields: [userId], references: [id])
  userId               String                 @unique
}

model AppConfig {
  id            String @id @default(uuid())
  maxActiveUser Int
}

model Product {
  id                   String                 @id @default(uuid())
  name                 String
  price                Int
  smallDescription     String
  description          Json
  images               String[]
  productFile          String
  category             CategoryTypes
  createdAt            DateTime               @default(now())
  User                 User?                  @relation(fields: [userId], references: [id])
  userId               String?
}

enum CategoryTypes {
  template
  uikit
  icon
}
